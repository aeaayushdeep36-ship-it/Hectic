# The mock provider is the default and needs no key. Copy to .env.local to override.
LLM_PROVIDER=mock

# Free-tier keys only. Never commit real values.
# Gemini is the primary real model; Groq is the secondary live-gate model.
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
# OpenRouter stays supported but is not required for the live gate.
OPENROUTER_API_KEY=
# Optional second key for the two-model live gate's daily request allowance.
OPENROUTER_SECOND_API_KEY=

# OpenRouter defaults to the free tier of an open-weight model.
# Paid variant, if you explicitly override: google/gemma-4-31b-it
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional extra models for the live repetition gate (comma-separated).
# If an upstream free pool is rate-limited, pin responsive models here instead.
OPENROUTER_SECOND_MODEL=
OPENROUTER_LIVE_MODELS=

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Extra hostnames allowed to reach the API (comma-separated). Loopback is always
# allowed. Only set this behind a reverse proxy you control.
HECTIC_ALLOWED_HOSTS=
