# The mock provider is the default and needs no key. Copy to .env.local to override.
LLM_PROVIDER=mock

# Free-tier keys only. Never commit real values.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# OpenRouter defaults to the free tier of an open-weight model.
# Paid variant, if you explicitly override: google/gemma-4-31b-it
OPENROUTER_MODEL=google/gemma-4-31b-it:free

OLLAMA_BASE_URL=http://127.0.0.1:11434
