{
  "name": "hectic",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "engine:boundary": "node scripts/engine-boundary.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run engine:boundary",
    "audit": "tsx scripts/audit.ts",
    "eval:agents": "tsx scripts/eval-agents.ts",
    "eval:gate": "tsx scripts/eval-gate.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "demo:rehearse": "tsx scripts/demo-rehearse.ts",
    "diagram:png": "node scripts/render-diagram.mjs",
    "demo:video": "node scripts/record-demo.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/db-clean.mjs && tsx db/seed.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "better-sqlite3": "13.2.0",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^1.79.0",
    "nanoid": "6.0.2",
    "next": "16.4.6",
    "papaparse": "^5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "fast-check": "4.11.0",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
